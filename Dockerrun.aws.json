{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "bank-management-app",
      "image": "YOUR_DOCKER_USERNAME/bank-management-app:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 8080
        }
      ],
      "environment": [
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:mysql://bank-db.xxxxx.us-east-1.rds.amazonaws.com:3306/bankdb"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "root"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "YourSecurePassword123"
        },
        {
          "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
          "value": "update"
        },
        {
          "name": "SPRING_JPA_SHOW_SQL",
          "value": "false"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/elasticbeanstalk/bank-management-env/var/log/bank-app.log",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "eb-docker"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/api/accounts || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
